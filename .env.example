# ===== LLM（DeepSeek，OpenAI 兼容协议）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 所有抽取/分类/路由调用固定为 0，保证可复现
LLM_TEMPERATURE=0

# ===== MySQL 8.0 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=bank_agent

# ===== 外部实时金融数据：阿里云百炼 MCP 广场 =====
# 东方财富妙想 · 智能投研（StreamableHTTP 端点，仅接入 read_agent 作为只读外部数据源）
# 留空则 read_agent 自动降级为纯本地工具清单，不阻塞服务启动
DASHSCOPE_API_KEY=
# MCP_ENDPOINT 默认由 config.py 填充，除非要换端点否则无需填写
# MCP_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/mcps/market-cmgjmcp00074946/mcp

# ===== Mock 银行服务（FastAPI）=====
BANK_API_HOST=127.0.0.1
BANK_API_PORT=8000
# 留空则自动拼成 http://127.0.0.1:8000
BANK_API_BASE=

# ===== 安全：匿名回落（审计 R1）=====
# 0 = 无 token 一律 401（多真实用户时必须，当前默认）；
# 1 = 无 token 回落演示主账号（仅单机纯演示）
BANK_ALLOW_ANON=0

# ===== 数字柜员（Fay 渲染端，可选）=====
# Fay 作为独立子进程运行（agaent/fay/Fay），本项目只通过 HTTP 喂话，业务域零改动。
# 全部留空 = 功能关闭（演示默认关，桥接层静默 no-op）。
# 前端用户菜单「数字柜员 开/关」默认关；开关打开且下列 URL 已配置才会真正喂话。
# ★ 下列路径已按本机 Fay 源码核对（gui/flask_server.py；Flask 监听 0.0.0.0:5000）。
FAY_API_URL=            # Fay HTTP 基址，本机为 http://127.0.0.1:5000
FAY_FRONTEND_URL=       # 数字人前端基址，本机 Live2D 为 http://127.0.0.1:5173
# ★ FAY_USERNAME 必须与前端连 WS 10002 时注册的 Username 完全一致
#   （Fay 按 username 精确过滤后定向推送，不一致 → 前端收不到任何口型/语音帧）。
#   mate-human Live2D 前端在 src/lappmodel.ts 硬编码为 'User'，故默认 'User'。
FAY_USERNAME=User
# 以下三项已按源码核对并实测，通常无需改动
FAY_SPEAK_PATH=/transparent-pass       # 逐字念出（POST，form data={"user","text"} 的 JSON 串）
FAY_STOP_PATH=/to-stop-talking         # 打断（POST，JSON {"username"}）
FAY_HEALTH_PATH=/api/get-system-status # 探活（GET）
# 数字人驱动 WS（Fay 的 10002）。「与小微对话」时前端会**旁听**它，
# 用真实音频帧的 Time 累计值算出播报时长 → 决定何时重开麦克风（比按文本估算准得多）。
FAY_WS_URL=ws://127.0.0.1:10002
FAY_API_TIMEOUT=2                      # 单请求超时（秒），超时即静默跳过

# ---- 朗读文本口语化（只影响"念出来"的话，聊天区展示的原文一字不改）----
FAY_SPEAK_DIGEST=1        # 1 = 去 Markdown/emoji，列表折叠（默认）；0 = 原样朗读（排查用）
# 连续列表最多念几项，其余用「等」带过：1 = 只念第一项（默认，按产品要求）；
# 2/3 = 多念几项；0 = 不折叠（把列表念全，适合"转账回执"这类关键几项）。
FAY_SPEAK_LIST_ITEMS=1
